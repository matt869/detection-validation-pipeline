## auditd rules for the validation lab
##
## Scoped to the sources declared in mapping/telemetry_sources.yml:
##   auditd_execve     - command execution
##   auditd_file_write - writes to watched paths
##
## Install to /etc/audit/rules.d/50-dvp.rules and run `augenrules --load`.
##
## Verify after loading. A rule that failed to load is indistinguishable from a
## quiet host until the harness reports every Linux rule as BLIND:
##   auditctl -l | wc -l
##   auditctl -s | grep -E 'lost|backlog'

## Reset. Anything above this line in another file is discarded.
-D

## Backlog. The default of 64 drops records under any real load, and a dropped
## record looks exactly like a behaviour that never happened - which is the
## single worst failure mode for a validation pipeline. 8192 is generous;
## measure `auditctl -s` lost counters before reducing it.
-b 8192
--backlog_wait_time 60000

## Failure mode 1 = printk. Do not use 2 (panic) on a shared lab host.
-f 1

## Ignore the audit daemon's own noise before anything else.
-a never,exit -F arch=b64 -F exe=/usr/sbin/auditd
-a never,exit -F arch=b64 -F exe=/usr/sbin/augenrules

## ---------------------------------------------------------------------------
## Command execution -> auditd_execve
##
## auid>=1000 restricts to logged-in users; auid=4294967295 (unset) is excluded
## so daemon activity does not flood the log. Attackers operating as a service
## account with no login uid will therefore be missed here - that is a
## deliberate volume trade, and it is why the endpoint rules corroborate with
## file watches rather than relying on execve alone.
## ---------------------------------------------------------------------------
-a always,exit -F arch=b64 -S execve,execveat -F auid>=1000 -F auid!=4294967295 -k execve-watch
-a always,exit -F arch=b32 -S execve,execveat -F auid>=1000 -F auid!=4294967295 -k execve-watch

## Root shells regardless of login uid: the escalation itself is the signal.
-a always,exit -F arch=b64 -S execve,execveat -F euid=0 -F path=/bin/bash -k execve-watch
-a always,exit -F arch=b64 -S execve,execveat -F euid=0 -F path=/usr/bin/bash -k execve-watch

## ---------------------------------------------------------------------------
## Watched paths -> auditd_file_write
## ---------------------------------------------------------------------------

## Privilege escalation via sudo policy.  -> sudoers_modified
-w /etc/sudoers -p wa -k sudoers-watch
-w /etc/sudoers.d/ -p wa -k sudoers-watch

## Scheduled execution.                   -> cron_persistence
-w /etc/crontab -p wa -k cron-watch
-w /etc/cron.d/ -p wa -k cron-watch
-w /etc/cron.daily/ -p wa -k cron-watch
-w /etc/cron.hourly/ -p wa -k cron-watch
-w /etc/cron.weekly/ -p wa -k cron-watch
-w /etc/cron.monthly/ -p wa -k cron-watch
-w /var/spool/cron/ -p wa -k cron-watch
-w /etc/at.allow -p wa -k cron-watch
-w /etc/at.deny -p wa -k cron-watch

## Service persistence.                   -> T1543.002
-w /etc/systemd/system/ -p wa -k systemd-watch
-w /usr/lib/systemd/system/ -p wa -k systemd-watch
-w /etc/rc.local -p wa -k systemd-watch

## Account and authentication changes.
-w /etc/passwd -p wa -k identity-watch
-w /etc/shadow -p wa -k identity-watch
-w /etc/group -p wa -k identity-watch
-w /etc/gshadow -p wa -k identity-watch
-w /root/.ssh/ -p wa -k identity-watch
-w /etc/ssh/sshd_config -p wa -k identity-watch

## Audit configuration itself. Anyone turning this off is the reason it exists.
-w /etc/audit/ -p wa -k audit-config
-w /etc/audit/rules.d/ -p wa -k audit-config
-w /sbin/auditctl -p x -k audit-config
-w /sbin/auditd -p x -k audit-config

## ---------------------------------------------------------------------------
## Immutable.
##
## MUST BE LAST. -e 2 locks the rule set until reboot, so an attacker cannot
## quietly unload the watches. It also means a rules change needs a reboot -
## that is the trade, and it is the right one on a host whose whole job is to
## produce trustworthy telemetry.
##
## Comment this out while iterating on rules in the lab.
## ---------------------------------------------------------------------------
-e 2
